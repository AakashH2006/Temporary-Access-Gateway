# ---------- required: the gateway refuses to start without these ----------

# Postgres. Use a local socket/host in dev; set DATABASE_SSL=true for a
# managed provider (Neon, Supabase, RDS).
DATABASE_URL=postgres://temp_access_user:CHANGE-ME@localhost:5432/temp_access
DATABASE_SSL=false

# With DATABASE_SSL=true the server certificate is verified. Point this at the
# provider's CA bundle (Neon, Supabase and RDS all publish one) if Node's
# built-in roots do not already cover it.
DATABASE_CA_FILE=

# Skips certificate verification. The connection stays encrypted but is not
# authenticated, so anyone on the network path can read grant passwords and
# admin hashes. Only for a provider that genuinely cannot supply a CA.
DATABASE_SSL_INSECURE=false

# Pool limits. The connect timeout is what lets the readiness probe answer 503
# promptly when Postgres stops responding, instead of hanging.
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Session signing key. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The public origin customers reach. Emailed access links are built from
# this, so a wrong value ships dead links. In production this is your real
# https:// domain, NOT localhost.
PUBLIC_BASE_URL=http://localhost:3000

# The VPN-hosted app the gateway forwards to. The gateway must be able to
# reach this address; the customer must not. The gateway warns at boot if this
# resolves to a public address, because that usually means it never was
# isolated -- but the only real check is the network itself, plus an audit of
# every DNS record and hardcoded URL that points at the app directly.
UPSTREAM_URL=http://127.0.0.1:4000

# ---------- optional ----------

PORT=3000

# How long one login lasts. Always capped at the grant's own expiry, so this
# only controls how often a customer has to re-enter their password within a
# long window.
SESSION_TTL_SECONDS=3600

# ---------- the three clocks ----------
# Keep these distinct; conflating any two produces a bug that is very hard to
# recognise from a support ticket.
#
#   link validity   PENDING_EXPIRY_HOURS   runs from grant creation
#   access window   durationHours          runs from activation
#   login session   SESSION_TTL_SECONDS    runs from login

# Ceiling on the access window an admin may hand out, in hours. A ceiling, not
# a default -- the admin names a duration on every grant and this only rejects
# values above it.
#
# 24 is a deliberate starting position: a 30-day ceiling on a system called
# temporary access is the kind of default a security review circles. Raising it
# is a one-line change, so ask the client for their longest realistic access
# period before handover -- a contractor on a two-week job would otherwise need
# a fresh link every day, which is friction for the admin and more live
# credentials in flight.
MAX_DURATION_HOURS=24

# How long an unopened link stays activatable, from creation. Not the access
# window: this one governs the link sitting in the customer's inbox. Without
# it, a link created and never opened stays live indefinitely -- and so do the
# credentials in that email.
PENDING_EXPIRY_HOURS=24

# Set to true ONLY when nginx (or another reverse proxy) is in front. It makes
# Express trust X-Forwarded-For. Enabling it without a proxy lets any client
# spoof its IP in the audit log and dodge rate limits; leaving it off behind
# nginx collapses every visitor into one rate-limit bucket.
TRUST_PROXY=false

# Forces the Secure flag on the session cookie. Inferred automatically when
# PUBLIC_BASE_URL is https, so you rarely need to set this.
COOKIE_SECURE=false

# Injects the countdown bar into the app's HTML pages. Turn off if it
# collides with the app's own layout.
INJECT_BANNER=true

# Strips the upstream app's Content-Security-Policy so the injected banner
# can run. You should not need this: the gateway gives the banner a per-response
# nonce and adds it to the app's existing script-src/style-src instead, which
# keeps the app's policy intact. This remains as an escape hatch for a policy
# the rewrite cannot handle -- it does weaken the app's own protections.
STRIP_UPSTREAM_CSP=false

# How long a grant's status may be cached before the proxy re-reads Postgres.
# Logout and admin-revoke bust the cache directly, so this is only the worst
# case for a change made by another process.
GRANT_CACHE_TTL_MS=5000

# How often expired grants are swept into the EXPIRED state. The same timer
# drops stale entries from the in-process grant cache.
SWEEP_INTERVAL_MS=60000

# Failed customer sign-ins before that grant locks, and for how long. Counted
# in the database, so a lockout survives a restart and applies to an attempt
# spread across many IP addresses -- which is exactly what the per-IP limiter
# below cannot see. Keep GRANT_MAX_FAILED_ATTEMPTS at or below LOGIN_RATE_MAX,
# or a single-source attack trips the limiter first and the lockout never
# fires from one address.
GRANT_MAX_FAILED_ATTEMPTS=8
GRANT_LOCKOUT_MINUTES=15

# Per-IP throttle on customer sign-in. Note that customers behind one office
# NAT share a bucket, so this is not the place to be clever.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MINUTES=1

# ---------- upstream isolation ----------

# Sent as a header on every proxied request when set. The app should reject
# any request that does not carry it, which is what stops a customer who
# discovers the app's own address from simply going around the gateway. It
# needs about ten lines of middleware on the app's side; DEPLOY.md has the
# check. Strongly recommended -- the gateway is worth nothing without it or an
# equivalent network control.
#   UPSTREAM_SHARED_SECRET=$(node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
UPSTREAM_SHARED_SECRET=

# The header the secret travels in. Change it only if it collides with
# something the app already uses.
UPSTREAM_SECRET_HEADER=X-Gateway-Secret

# ---------- audit log retention ----------

# Used by `npm run prune-audit`, which is meant for cron. The audit log is
# append-only and the application never deletes from it; this is the one
# exception. The default is here so the answer to "how long do you keep access
# records" exists before anyone asks.
AUDIT_RETENTION_MONTHS=12

# ---------- admin console ----------

# CIDRs allowed to reach the admin console at all. Empty means no restriction,
# which is fine locally. In production scope this to your VPN or office range:
# admins already have VPN access by the premise of this system, so the console
# never needs to answer the public internet. Requires TRUST_PROXY=true behind
# nginx, or every request appears to come from the proxy.
#   ADMIN_IP_ALLOWLIST=10.8.0.0/24,203.0.113.7
ADMIN_IP_ALLOWLIST=

# How long an admin stays signed in before re-entering their password.
ADMIN_SESSION_TTL_SECONDS=3600

# Failed sign-ins before the account locks, and for how long. Counted in the
# database, so a lockout survives a restart.
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# There is no ADMIN_API_KEY. The FIRST admin account is created on the host:
#   npm run create-admin
# which is also the recovery path for a lost password or a locked account.
#
# After that, an owner adds colleagues from the console's Team tab. Those
# accounts get a generated temporary password shown once, and must change it
# before they can do anything else.
#
# Roles, narrowest first:
#   auditor  read the grant list and the audit log, including the CSV export
#   admin    issue, extend, re-send and revoke grants; everything an auditor can
#   owner    everything, plus adding, disabling and re-roling admins
#
# `npm run create-admin` defaults to owner, because its usual job is creating
# the first account on a new deployment. Pass --role=admin or --role=auditor to
# override. An existing account's role is never changed unless --role is given
# explicitly -- password recovery must not double as a promotion.
#
# That script also reads ADMIN_EMAIL, ADMIN_PASSWORD and ADMIN_ROLE from the
# environment for unattended runs (a container bootstrap, CI). They are not
# read by the gateway itself and do not belong in a deployed .env -- pass them
# on the command that needs them:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=... npm run create-admin -- --force
# The password comes from the environment rather than an argument because an
# argument is visible in `ps` and lands in shell history.

# ---------- email ----------
# Resend is what this runs on; the free tier (3,000/month, 100/day) covers the
# expected volume. Leave EMAIL_PROVIDER blank to select whichever backend has
# credentials, or set it to "resend" or "ses" to be explicit.
#
# SES exists so the provider is a config-level swap rather than a rewrite. It
# is not a security improvement over Resend -- do not treat changing provider
# as security work.
#
# If email is not configured at all, grant creation still works: the response
# returns the password for the admin to relay by hand, and the gateway says so
# at boot. That is a fallback, not a plan.
EMAIL_PROVIDER=

# Resend. Without a verified domain it only sends FROM onboarding@resend.dev
# TO the address you signed up with, so real customers receive nothing until a
# domain is verified.
#
# Verifying the client's domain (SPF + DKIM records in their DNS) is the
# longest lead time in the whole project. Start it before anything else.
RESEND_API_KEY=

# Amazon SES, if the provider ever changes. Needs a verified identity for
# EMAIL_FROM in that region, and production access -- a new SES account is
# sandboxed and can only send to verified addresses.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# The From address, whichever backend is in use. In production this is a
# subdomain of the client's domain, so the sending reputation of these
# messages is isolated from their corporate mail:
#   EMAIL_FROM=access@mail.theircompany.com
EMAIL_FROM=onboarding@resend.dev

# Per-IP throttle on admin sign-in. Keep this LOOSER than
# ADMIN_MAX_FAILED_ATTEMPTS above: the per-account lockout should be what
# stops an attack on one account, so operators see an audited ADMIN_LOCKED
# event rather than an opaque 429. This limiter is for hammering and for
# spraying across many accounts.
ADMIN_LOGIN_RATE_MAX=10
ADMIN_LOGIN_RATE_WINDOW_MINUTES=15

# ---------- two-factor for admins ----------

# Refuses to let an admin use the console until they have enrolled an
# authenticator app. Sign-in still works, and the console shows the enrolment
# screen and nothing else -- so turning this on does not lock anybody out, it
# stops them working until they spend two minutes with their phone.
#
# Off by default only so an existing deployment survives the upgrade that added
# it. Turn it on. An admin password is the credential that mints access to the
# internal network for anyone, and it is the credential most likely to be
# phished, reused, or sitting in a password manager on a laptop in a coffee
# shop. Everything else in this system assumes it is hard to become an admin.
#
# Once on, no admin can turn their own two-factor off.
ADMIN_REQUIRE_TOTP=false

# ---------- grant provenance ----------

# Requires the admin to say why, on every grant -- a ticket, an incident, a
# contract. Off by default because it is a policy decision, not a technical
# one.
#
# Turn it on if anyone will ever ask "who had access to this system in March,
# and on whose authority". The answer has to be written down at the moment
# access is granted; there is no reconstructing it from timestamps afterwards.
# The value is stored on the grant and shown in the console's list.
REQUIRE_GRANT_REASON=false

# ---------- logging ----------

# debug|info|warn|error. debug includes one line per proxied request, which on
# a reverse proxy means every image and stylesheet the upstream app pulls in --
# useful while diagnosing, expensive as a steady state.
LOG_LEVEL=info

# json|pretty. Defaults to pretty when stdout is a terminal and json otherwise,
# which is right for `npm start` on a laptop and for a container both. Set it
# explicitly if you run under a supervisor that gives the process a TTY and
# then ships the output to a collector anyway.
LOG_FORMAT=

# Every request is given an id -- taken from an inbound X-Request-Id when one
# is present and well-formed, generated otherwise -- and it appears in the
# response header, in every log line for that request, and in the audit_log
# row. A customer reporting a failure can quote the header, and that finds the
# exact request. Nothing to configure.

# ---------- metrics ----------

# Prometheus scrape target at /__access/metrics, served ONLY when this is set,
# and only to a caller presenting it as `Authorization: Bearer <token>`.
# Anything else gets a 404, so a scanner cannot tell the endpoint exists.
#
# It is not public because the numbers describe how much access is being
# granted and how often sign-in fails, which is reconnaissance on the one door
# into the internal network.
#   openssl rand -hex 32
METRICS_TOKEN=

# ---------- webhooks ----------

# Where to POST lifecycle events: a SIEM, a SOC channel, a ticketing system.
# Leave blank to disable entirely -- nothing is queued and nothing is sent.
#
# Events are written to a durable outbox inside the request that caused them
# and delivered from there by the background sweeper, so a slow or unreachable
# consumer cannot slow down issuing a grant, and a delivery interrupted by a
# deploy is still queued afterwards.
WEBHOOK_URL=

# Signs every delivery. The receiver gets:
#
#   X-Gateway-Signature: sha256=<hex>   HMAC-SHA256 of "<timestamp>.<body>"
#   X-Gateway-Timestamp: <unix seconds>
#   X-Gateway-Event:     GRANT_CREATED
#   X-Gateway-Delivery:  <id, stable across retries>
#
# The receiver should recompute the HMAC with a constant-time compare, and
# reject a timestamp more than a few minutes old -- that is what makes a
# captured body unreplayable. Strongly recommended: an unauthenticated POST on
# a public URL is trusted by anyone who learns the URL, and "access was granted
# to X" is a message worth forging.
WEBHOOK_SECRET=

# Which events to send, comma-separated. Empty means all of them, which is
# right for a SIEM and far too noisy for a chat channel.
#   WEBHOOK_EVENTS=GRANT_CREATED,GRANT_REVOKED,GRANT_EXTENDED,ADMIN_LOCKED,ADMIN_CREATED
WEBHOOK_EVENTS=

# Attempts before a delivery is abandoned, and how long each POST may take.
# Backoff is exponential with jitter, capped at 15 minutes between tries.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=5000

# How many queued events one sweeper pass delivers. Raise it if a backlog after
# an outage drains too slowly; each row is one sequential HTTP request, so the
# pass takes up to WEBHOOK_BATCH x WEBHOOK_TIMEOUT_MS in the worst case, and
# that has to stay well inside SWEEP_INTERVAL_MS.
WEBHOOK_BATCH=20

# How long delivered rows are kept, swept by `npm run prune-audit`. FAILED rows
# are never swept: a security event that was never handed to the consumer is
# exactly what someone will want to find later.
WEBHOOK_RETENTION_DAYS=30

# ---------- shutdown ----------

# How long to wait for in-flight requests on SIGTERM before exiting anyway.
# Keep it below your orchestrator's grace period (30s for both Docker and
# Kubernetes by default) so this process decides how it dies rather than being
# SIGKILLed with the connection pool open.
SHUTDOWN_TIMEOUT_MS=15000

# ---------- the demo stack only ----------
# docker-compose.yml reads these from a .env beside it, and none of them are
# read by the application itself. Every one has a working default, so the demo
# needs no .env at all.
#
#   GATEWAY_PORT           where the gateway is published        (3000)
#   DEMO_APP_PORT          where the stand-in app is published   (4001)
#   DEMO_ADMIN_EMAIL       the admin the bootstrap creates       (admin@example.com)
#   DEMO_ADMIN_PASSWORD    its password; generated and printed if unset
#
# The demo also picks up JWT_SECRET, RESEND_API_KEY, EMAIL_FROM and
# EMAIL_PROVIDER from here if you have set them, which is how you watch a real
# email arrive instead of reading the password off the admin console.
