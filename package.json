{
  "name": "temp-access-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Identity-aware reverse proxy granting time-boxed access to a VPN-hosted app",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo-app": "node demo-app/app.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1",
    "prune-audit": "node scripts/prune-audit.js",
    "demo": "docker compose up --build -d && docker compose logs bootstrap",
    "demo:logs": "docker compose logs -f gateway demo-app",
    "demo:down": "docker compose down",
    "demo:reset": "docker compose down -v"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
